# Environment
NODE_ENV=production
PORT=5000

# Database Connection (MongoDB Atlas or local MongoDB)
# Example MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/imovies?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/imovies

# JWT Secret Key
JWT_SECRET=imovies_super_secret_jwt_key_2026_production

# Optional: Set to true if running backend and serving client together
SERVE_CLIENT=true
